  "comparison_observations": [
    {
      "id": "lower_face_contour",
      "category": [
        "shape",
        "lighting_secondary"
      ],
      "observation_zh": "原图颊部到下巴是连续收束的柔和轮廓；最终图下巴中央呈突出的块状小面，两侧颌缘的折转更硬，下唇下方到下巴的体块关系也不同。",
      "fit_implication_zh": "先拟合下颌收束位置、下巴宽高及其与口裂的关系；不能只整体缩放脸宽。单张有光照差异的图不能精确测出深度。"
    },
    {
      "id": "nose_base",
      "category": [
        "shape",
        "lighting_secondary"
      ],
      "observation_zh": "最终图鼻头/鼻翼基底显得更宽鼓，两侧鼻孔成为更外露的深色开口；原图鼻翼更收拢，鼻头与鼻梁的转折更小。",
      "fit_implication_zh": "同时核对鼻翼外缘、鼻底和鼻尖，而非把最亮高光当鼻尖或仅匹配一个鼻点。鼻孔暗度需与真实几何分开检查。"
    },
    {
      "id": "eyelids_and_iris_boundary",
      "category": [
        "eyelid_structure",
        "texture"
      ],
      "observation_zh": "最终图上眼缘与内眼角的黑区更粗重，眼睑、虹膜和下眼缘局部糊成一块；原图可见眼裂弧度及虹膜边界更轻、分层更明确。",
      "fit_implication_zh": "两眼中心对齐不足以说明眼睛正确，需独立核对四个眼角、上下眼裂极值及虹膜中心；睫毛/眼影厚度不得直接转化成眼皮厚度。"
    },
    {
      "id": "mouth_and_lips",
      "category": [
        "lip_structure",
        "shape",
        "texture_secondary"
      ],
      "observation_zh": "最终图唇缘更厚重、上唇起伏显得更鼓，嘴角呈尖锐暗凹；原图口裂更细，唇峰较软，右嘴角上扬与左侧较平的关系更轻微。",
      "fit_implication_zh": "优先约束嘴角高差、上唇中央轮廓、下唇下缘及口裂；上唇的真实厚度还需灰模/换光确认。"
    },
    {
      "id": "forehead_brow_occlusion",
      "category": [
        "hair_shape",
        "occlusion"
      ],
      "observation_zh": "最终图刘海是较粗的分块发束，额头露出和眉尾附近的遮挡关系不同；原图发丝较细，透肤与眉端显露更零碎。这会改变上半脸辨识。",
      "fit_implication_zh": "眉端遮挡点降权，先建立皮肤头模；不要通过改额骨或眉弓去补错误刘海边界。"
    },
    {
      "id": "face_light_and_albedo",
      "category": [
        "lighting",
        "material"
      ],
      "observation_zh": "原图面颊有暖粉渐变、鼻梁/鼻头有明确亮部；最终图大面积肤色偏平，鼻梁和眼下的层次被削弱，鼻孔与唇角暗区反而更突出。",
      "fit_implication_zh": "需同角度灰模和受控换光区分形体与材质。以上明暗差异不能直接证明鼻梁高度或颧骨深度错误，也不能靠重新投射原图证明几何相似。"
    }
  ],
